#!/usr/bin/env bash
# Pre-commit hook for spacesim2.
#
# Enforces style and types with the project's uv-pinned tools (so versions
# always match uv.lock):
#   - ruff format  (formatting)   — staged Python files
#   - ruff check   (lint)         — staged Python files
#   - mypy         (types)        — whole project
#
# mypy runs over the whole project, not just staged files, because it needs
# cross-module context to resolve types correctly.
#
# Bypass once with:  git commit --no-verify
set -euo pipefail

# Staged, still-present Python files (added/copied/modified), NUL-delimited so
# paths with spaces survive.
mapfile -d '' -t files < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.py')

if [ ${#files[@]} -eq 0 ]; then
  exit 0
fi

if ! uv run ruff format --check "${files[@]}"; then
  {
    echo
    echo "✗ ruff format: staged files are not formatted. Fix with:"
    echo "    uv run ruff format ${files[*]}"
    echo "  then 'git add' them and recommit (or 'git commit --no-verify' to skip)."
  } >&2
  exit 1
fi

if ! uv run ruff check "${files[@]}"; then
  {
    echo
    echo "✗ ruff check: staged files have lint errors. Many are auto-fixable:"
    echo "    uv run ruff check --fix ${files[*]}"
    echo "  then 'git add' them and recommit (or 'git commit --no-verify' to skip)."
  } >&2
  exit 1
fi

if ! uv run mypy .; then
  {
    echo
    echo "✗ mypy: type errors found. Fix them, then recommit"
    echo "  (or 'git commit --no-verify' to skip)."
  } >&2
  exit 1
fi
